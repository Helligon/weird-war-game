{
  "permissions": {
    "deny": [
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_main_merge.py\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
